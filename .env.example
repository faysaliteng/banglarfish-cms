# ============================================================================
# Banglarfish — environment configuration (copy to .env and fill in)
# ============================================================================

# --- Database (required) ---
# Local Postgres on the VPS (unix host). Format:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgres://banglarfish:CHANGE_ME@127.0.0.1:5432/banglarfish"
# Set to "true" only if your Postgres requires SSL (most local installs do not).
DATABASE_SSL="false"
# Max pooled DB connections (KVM 1 is fine with 10).
DB_POOL_MAX="10"

# --- App server ---
NODE_ENV="production"
# Port the Node server listens on (nginx proxies to this).
PORT="3000"
# Public base URL of the site (used for links in emails/SMS if you add them).
APP_URL="https://banglarfish.com"
# Where uploaded media is written on disk. nginx serves /uploads from here.
UPLOAD_DIR="/var/www/banglarfish/uploads"

# --- SMS / OTP (Boomcast) ---
# While SMS_DEV_MODE=true, OTP codes are printed to the server log instead of
# being sent (useful before you have SMS credits). Set to false in production.
SMS_DEV_MODE="true"
# Fill these in from your Boomcast account, then set SMS_DEV_MODE=false.
BOOMCAST_API_URL="https://api.boomcast.com.bd/boomcast/api/v2/sendtext"
BOOMCAST_API_KEY=""
BOOMCAST_SECRET_KEY=""
BOOMCAST_SENDER_ID="Banglarfish"
# Advanced: override the HTTP method and query param names if your Boomcast
# account uses a different contract (defaults shown).
# BOOMCAST_METHOD="GET"
# BOOMCAST_PARAM_APIKEY="apikey"
# BOOMCAST_PARAM_SECRET="secretkey"
# BOOMCAST_PARAM_SENDER="callerID"
# BOOMCAST_PARAM_TO="toUser"
# BOOMCAST_PARAM_MSG="messageContent"

# --- Payments ---
# simulate (default, testable without credentials) | sandbox | live
PAYMENT_MODE="simulate"
# SSLCommerz (card + MFS aggregator) — https://developer.sslcommerz.com
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWD=""
# bKash tokenized checkout — https://developer.bka.sh
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
# Nagad (RSA keys) — falls back to simulate until fully wired
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""

# --- Visitor geo-location (optional) ---
# e.g. http://ip-api.com/json/{ip}  — leave blank to skip geo lookups
GEOIP_ENDPOINT=""

# --- Seed defaults (used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@banglarfish.com"
SEED_ADMIN_PASSWORD="ChangeMe#2026"
SEED_ADMIN_PHONE="01700000000"
